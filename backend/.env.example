# Copy to .env — every value below works against `docker compose -f infra/docker-compose.yml up -d`.
NODE_ENV=development
PORT=3000
# Comma-separated origin allowlist, or * for any origin (dev only; production refuses to start with *).
CORS_ORIGINS=*
# Largest JSON body accepted (uploads go straight to S3 via presigned URLs).
BODY_LIMIT=100kb
# Reverse-proxy hops in front of the API (>0 makes rate limits/logs use X-Forwarded-For). 0 = direct.
TRUST_PROXY=0
# Public base URL of the app/web (used in password-reset links).
APP_BASE_URL=http://localhost:3000

# --- PostgreSQL (e2e tests use sketchsquare_test automatically) ---
DATABASE_URL=postgresql://sketch:sketch@localhost:5432/sketchsquare
# TEST_DATABASE_URL=postgresql://sketch:sketch@localhost:5432/sketchsquare_test

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379
# QUEUE_PREFIX=bull

# --- S3 (MinIO locally; AWS S3 / Cloudflare R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
# Host embedded in presigned URLs for clients. Android emulator: http://10.0.2.2:9000. Leave empty to reuse S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_BUCKET_ORIGINALS=originals
S3_BUCKET_PREVIEWS=previews
S3_BUCKET_KYC=kyc
# Public base URL of the previews bucket (CDN in prod).
S3_PREVIEWS_PUBLIC_URL=http://localhost:9000/previews

# --- Auth (CHANGE in any shared/prod environment) ---
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
RATE_LIMIT_ENABLED=true
# Per client IP and route, for every POST/PUT/PATCH/DELETE (some routes are stricter).
RATE_LIMIT_WRITE_PER_MIN=60
# redis = counters shared by all API instances; memory = per process.
RATE_LIMIT_STORAGE=redis

# --- Email (Mailpit UI: http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SketchSquare <no-reply@sketchsquare.local>"

# --- Business rules ---
FREE_DOWNLOAD_LIMIT=20
PLATFORM_FEE_BPS=1000
MIN_WITHDRAWAL_PAISE=50000
# Free drawings required per already-published paid drawing before another paid one can be published (0 disables)
CONTRIBUTION_FREE_PER_PAID=1
# Plagiarism check: a new drawing is held for admin review when a preview's pHash is within this Hamming distance (0-64) of another architect's drawing on a similar plot (+/- tolerance %, rotation included)
PLAGIARISM_PHASH_THRESHOLD=8
PLAGIARISM_PLOT_TOLERANCE_PCT=5

# --- Razorpay (leave empty => stub checkout mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Payouts: stub by default; razorpayx only activates when its keys are set ---
PAYOUT_PROVIDER=stub
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
# Stub payouts complete after this many ms (accounts ending in 0000 are rejected, to test failures)
STUB_PAYOUT_DELAY_MS=2000

# --- Push notifications (FCM HTTP v1, service-account key). Leave empty => stub sender (logs only) ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Paste the private key with literal \n for line breaks
FCM_PRIVATE_KEY=
