# Copy to .env — every value below works against `docker compose -f infra/docker-compose.yml up -d`.
NODE_ENV=development
PORT=3000
# Comma-separated allowlist, or * for any origin (dev only).
CORS_ORIGINS=*
# Public base URL of the app/web (used in password-reset links).
APP_BASE_URL=http://localhost:3000

# --- PostgreSQL (e2e tests use sketchsquare_test automatically) ---
DATABASE_URL=postgresql://sketch:sketch@localhost:5432/sketchsquare
# TEST_DATABASE_URL=postgresql://sketch:sketch@localhost:5432/sketchsquare_test

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379
# QUEUE_PREFIX=bull

# --- S3 (MinIO locally; AWS S3 / Cloudflare R2 in prod) ---
S3_ENDPOINT=http://localhost:9000
# Host embedded in presigned URLs for clients. Android emulator: http://10.0.2.2:9000. Leave empty to reuse S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_BUCKET_ORIGINALS=originals
S3_BUCKET_PREVIEWS=previews
S3_BUCKET_KYC=kyc
# Public base URL of the previews bucket (CDN in prod).
S3_PREVIEWS_PUBLIC_URL=http://localhost:9000/previews

# --- Auth (CHANGE in any shared/prod environment) ---
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=60
RATE_LIMIT_ENABLED=true

# --- Email (Mailpit UI: http://localhost:8025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SketchSquare <no-reply@sketchsquare.local>"

# --- Business rules ---
FREE_DOWNLOAD_LIMIT=20
PLATFORM_FEE_BPS=1000
MIN_WITHDRAWAL_PAISE=50000

# --- Razorpay (leave empty => stub checkout mode) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Payouts: stub by default; razorpayx only activates when its keys are set ---
PAYOUT_PROVIDER=stub
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_WEBHOOK_SECRET=
